---
import Icon from './Icon.astro';

interface Props {
  id: string;
  label: string;
  name?: string;
  type?: string;
  value?: string;
  helperText?: string;
  required?: boolean;
  disabled?: boolean;
  readonly?: boolean;
  class?: string;
}

const {
  id,
  label,
  name = id,
  type = 'text',
  value,
  helperText,
  required = false,
  disabled = false,
  readonly = false,
  class: className,
} = Astro.props;

const hasIcon = Astro.slots.has('icon');
const helperId = helperText ? `${id}-helper` : undefined;
---

<div class:list={['field', { 'field--disabled': disabled }, className]}>
  <div class="field-control">
    <input
      class="field-input"
      id={id}
      name={name}
      type={type}
      value={value}
      placeholder=" "
      required={required}
      disabled={disabled}
      readonly={readonly}
      aria-describedby={helperId}
    />

    <label class="field-label" for={id}>
      {label}
      {required && <span aria-hidden="true"> *</span>}
    </label>

    {hasIcon && (
      <span class="field-icon">
        <slot name="icon" />
      </span>
    )}
  </div>

  {helperText && (
    <p class="field-helper" id={helperId}>{helperText}</p>
  )}
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    width: 100%;
  }

  .field-control {
    position: relative;
    display: flex;
    align-items: center;
    height: 56px;
    padding: 0 var(--space-4);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-400);
    border-radius: var(--radius-md);
    box-shadow: 0 0 0 0 transparent;
    transition: border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .field-control:focus-within {
    border-color: var(--color-primary-300);
    box-shadow: inset 0 0 0 1px var(--color-primary-300);
  }

  .field-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 26px 0 6px;
    border: none;
    outline: none;
    background: none;
    font-family: var(--font-body);
    font-size: var(--text-paragraph-body);
    color: var(--color-body);
  }

  .field-input:read-only {
    cursor: pointer;
  }

  .field-label {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    max-width: calc(100% - var(--space-8));
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transform: translateY(-50%) scale(1);
    transform-origin: left center;
    font-family: var(--font-body);
    font-size: var(--text-paragraph-body);
    color: var(--color-neutral-600);
    pointer-events: none;
    transition: transform var(--transition-base), color var(--transition-base);
  }

  .field-input:focus + .field-label,
  .field-input:not(:placeholder-shown) + .field-label {
    transform: translateY(calc(-50% - 12px)) scale(0.875);
    color: var(--color-primary-300);
  }

  .field-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-neutral-600);
  }

  .field-helper {
    padding: 0 var(--space-4);
    font-size: var(--text-paragraph-small);
    line-height: var(--leading-normal);
    color: var(--color-body);
  }

  /* -- Disabled -- */

  .field--disabled .field-control {
    background: var(--color-neutral-200);
    border-color: var(--color-neutral-400);
  }

  .field--disabled .field-input {
    color: var(--color-neutral-400);
    cursor: not-allowed;
  }

  .field--disabled .field-label,
  .field--disabled .field-input:not(:placeholder-shown) + .field-label {
    color: var(--color-neutral-400);
  }

  .field--disabled .field-icon {
    color: var(--color-neutral-400);
  }

  .field--disabled .field-helper {
    color: var(--color-neutral-400);
  }
</style>
