---
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout title="Mobile">
  <div class="preview-shell">
    <div class="device">
      <div class="device-notch">
        <span class="device-camera" />
      </div>
      <iframe
        id="device-screen"
        class="device-screen"
        src="/prototype"
        title="Mobile prototype preview"
      />
      <div class="device-home-bar" />
    </div>
  </div>
</BaseLayout>

<style>
  .preview-shell {
    min-height: 100vh;
    background: var(--color-gray-600);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-8);
  }

  .device {
    position: relative;
    width: 393px;
    height: 852px;
    background: var(--color-gray-500);
    border-radius: 48px;
    border: 4px solid var(--color-gray-400);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 32px 64px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    padding: 16px 9px 12px;
  }

  .device-notch {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 28px;
    background: var(--color-gray-500);
    border-radius: 0 0 18px 18px;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .device-camera {
    width: 10px;
    height: 10px;
    background: var(--color-gray-400);
    border-radius: 50%;
  }

  .device-screen {
    width: 375px;
    height: 812px;
    border: none;
    border-radius: 36px;
    background: var(--color-white);
    flex-shrink: 0;
  }

  .device-home-bar {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 120px;
    height: 4px;
    background: var(--color-gray-300);
    border-radius: var(--radius-full);
  }
</style>
