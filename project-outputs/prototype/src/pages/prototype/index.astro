---
import PrototypeLayout from '../../layouts/PrototypeLayout.astro';
---

<PrototypeLayout title="Homepage">
  <section class="hero">
    <div class="hero-content">
      <h1>Welcome to Plopsa</h1>
      <p>Discover our amazing theme parks and create unforgettable memories with your family.</p>
    </div>
  </section>
</PrototypeLayout>

<style>
  .hero {
    background: var(--color-secondary-beige-200);
    color: var(--color-body);
    padding: var(--space-10) var(--space-4);
    text-align: center;
  }

  .hero-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: 28px;
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
    color: var(--color-primary-300);
  }

  .hero p {
    font-size: var(--text-paragraph-body);
    line-height: var(--leading-normal);
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--space-24) var(--space-8);
    }

    .hero h1 {
      font-size: var(--text-display);
      margin-bottom: var(--space-4);
    }

    .hero p {
      font-size: var(--text-paragraph-lead);
    }
  }
</style>
