---
import PrototypeLayout from '../../layouts/PrototypeLayout.astro';
import BookingBar from '../../components/BookingBar.astro';
---

<PrototypeLayout title="Overnachten">
  <section class="page-title">
    <h1>Magisch overnachten</h1>
  </section>

  <section class="page-booking">
    <BookingBar guestsValue="2 gasten, 1 kamer" />
  </section>
</PrototypeLayout>

<style>
  .page-title {
    padding: var(--space-6) var(--space-4) var(--space-2);
  }

  .page-title h1 {
    font-size: 28px;
    line-height: var(--leading-tight);
    color: var(--color-primary-300);
  }

  .page-booking {
    padding: var(--space-4);
  }

  @media (min-width: 768px) {
    .page-title {
      padding: var(--space-8) var(--space-16) 0;
      max-width: 1440px;
      margin: 0 auto;
    }

    .page-title h1 {
      font-size: var(--text-h1);
      line-height: var(--leading-tight);
    }

    .page-booking {
      padding: var(--space-6) var(--space-16);
      max-width: 1440px;
      margin: 0 auto;
    }
  }
</style>
