---
import StorybookLayout from '../../layouts/StorybookLayout.astro';
---

<StorybookLayout title="Overview">
  <div class="overview">
    <p class="overview-intro">
      Design tokens and components for the Plopsa website prototype.
      Everything here is the single source of truth — components used in the prototype
      are the same ones documented below.
    </p>

    <div class="overview-grid">
      <a href="/storybook/colors" class="overview-card">
        <div class="overview-card-icon" style="background: var(--gradient-purple);" />
        <h3>Colors</h3>
        <p>Primary, secondary, tertiary, neutral, and semantic color tokens</p>
      </a>

      <a href="/storybook/typography" class="overview-card">
        <div class="overview-card-icon overview-card-icon--type">Aa</div>
        <h3>Typography</h3>
        <p>Font families, type scale, weights, and heading styles</p>
      </a>

      <a href="/storybook/spacing" class="overview-card">
        <div class="overview-card-icon overview-card-icon--spacing">
          <span /><span /><span />
        </div>
        <h3>Spacing</h3>
        <p>Spacing scale, border radius, and shadow tokens</p>
      </a>

      <a href="/storybook/icons" class="overview-card">
        <div class="overview-card-icon overview-card-icon--icons">
          <span class="mini-icon">&#9733;</span>
          <span class="mini-icon">&#9829;</span>
          <span class="mini-icon">&#9998;</span>
        </div>
        <h3>Icons</h3>
        <p>133 icons across 4 categories, served as a single SVG sprite</p>
      </a>

      <a href="/storybook/components/header" class="overview-card">
        <div class="overview-card-icon overview-card-icon--component">
          <span class="mini-header">
            <span class="mini-header-logo" />
            <span class="mini-header-line" />
            <span class="mini-header-line" />
            <span class="mini-header-line" />
          </span>
        </div>
        <h3>Header</h3>
        <p>Responsive navigation with logo, menu items, search, and tickets CTA</p>
      </a>

      <a href="/storybook/components/button" class="overview-card">
        <div class="overview-card-icon overview-card-icon--component">
          <span class="mini-btn">Button</span>
        </div>
        <h3>Button</h3>
        <p>Primary, secondary, and ghost button variants in three sizes</p>
      </a>

    </div>
  </div>
</StorybookLayout>

<style>
  .overview-intro {
    font-size: var(--text-paragraph-lead);
    color: var(--color-gray-400);
    max-width: 640px;
    margin-bottom: var(--space-8);
    line-height: var(--leading-normal);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4);
  }

  .overview-card {
    display: block;
    padding: var(--space-6);
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .overview-card:hover {
    border-color: var(--color-primary-300);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .overview-card h3 {
    font-size: var(--text-paragraph-lead);
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
  }

  .overview-card p {
    font-size: var(--text-paragraph-small);
    color: var(--color-gray-300);
    line-height: var(--leading-normal);
  }

  .overview-card-icon {
    width: 100%;
    height: 64px;
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-4);
  }

  .overview-card-icon--type {
    background: var(--color-gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-size: var(--text-h3);
    font-weight: var(--font-weight-semibold);
    color: var(--color-gray-500);
  }

  .overview-card-icon--spacing {
    background: var(--color-gray-100);
    display: flex;
    align-items: flex-end;
    gap: var(--space-2);
    padding: var(--space-3);
  }

  .overview-card-icon--spacing span {
    display: block;
    background: var(--color-primary-300);
    border-radius: var(--radius-sm);
    width: 20px;
  }

  .overview-card-icon--spacing span:nth-child(1) { height: 16px; }
  .overview-card-icon--spacing span:nth-child(2) { height: 28px; }
  .overview-card-icon--spacing span:nth-child(3) { height: 40px; }

  .overview-card-icon--component {
    background: var(--color-gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mini-btn {
    display: inline-block;
    padding: 6px 16px;
    background: var(--color-primary-300);
    color: var(--color-white);
    border-radius: var(--radius-md);
    font-size: var(--text-paragraph-xs);
    font-weight: var(--font-weight-semibold);
  }

  .overview-card-icon--icons {
    background: var(--color-gray-100);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
  }

  .mini-icon {
    font-size: var(--text-h4);
    color: var(--color-gray-500);
  }

  .mini-header {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .mini-header-logo {
    display: block;
    width: 24px;
    height: 10px;
    background: var(--color-primary-300);
    border-radius: 2px;
  }

  .mini-header-line {
    display: block;
    width: 16px;
    height: 3px;
    background: var(--color-primary-300);
    border-radius: 1px;
    opacity: 0.5;
  }

</style>
