---
import StorybookLayout from '../../layouts/StorybookLayout.astro';

const colorGroups = [
  {
    name: 'Neutrals',
    colors: [
      { token: '--color-white', hex: '#ffffff' },
      { token: '--color-black', hex: '#0b1215' },
      { token: '--color-gray-100', hex: '#f2f3f4' },
      { token: '--color-gray-200', hex: '#dbd7de' },
      { token: '--color-gray-300', hex: '#8e9497' },
      { token: '--color-gray-400', hex: '#4e4f52' },
      { token: '--color-gray-500', hex: '#202427' },
      { token: '--color-gray-600', hex: '#222334' },
    ],
  },
  {
    name: 'Primary — Purple',
    colors: [
      { token: '--color-primary-purple-200', hex: '#a1477f' },
      { token: '--color-primary-purple-300', hex: '#731c52' },
      { token: '--color-primary-purple-400', hex: '#461131' },
    ],
  },
  {
    name: 'Primary — Blue',
    colors: [
      { token: '--color-primary-blue-200', hex: '#6899b0' },
      { token: '--color-primary-blue-300', hex: '#3f6576' },
      { token: '--color-primary-blue-400', hex: '#314f5c' },
    ],
  },
  {
    name: 'Primary — Burgundy',
    colors: [
      { token: '--color-primary-burgundy-200', hex: '#b5476e' },
      { token: '--color-primary-burgundy-300', hex: '#a3194a' },
      { token: '--color-primary-burgundy-400', hex: '#80143a' },
    ],
  },
  {
    name: 'Primary — Red',
    colors: [
      { token: '--color-primary-red-200', hex: '#ed5a7b' },
      { token: '--color-primary-red-300', hex: '#d60f3c' },
      { token: '--color-primary-red-400', hex: '#a80c2f' },
    ],
  },
  {
    name: 'Primary — Orange',
    colors: [
      { token: '--color-primary-orange-200', hex: '#ec6726' },
      { token: '--color-primary-orange-300', hex: '#ee3d05' },
    ],
  },
  {
    name: 'Secondary — Green',
    colors: [
      { token: '--color-secondary-green-200', hex: '#9cc9c4' },
      { token: '--color-secondary-green-300', hex: '#569e95' },
      { token: '--color-secondary-green-400', hex: '#447d76' },
    ],
  },
  {
    name: 'Secondary — Beige',
    colors: [
      { token: '--color-secondary-beige-200', hex: '#fbf2ef' },
      { token: '--color-secondary-beige-300', hex: '#ebe0dc' },
      { token: '--color-secondary-beige-400', hex: '#d3b9b0' },
      { token: '--color-secondary-beige-500', hex: '#bc9485' },
    ],
  },
  {
    name: 'Secondary — Blue',
    colors: [
      { token: '--color-secondary-blue-200', hex: '#d9f2ff' },
      { token: '--color-secondary-blue-300', hex: '#a1daf8' },
      { token: '--color-secondary-blue-400', hex: '#5dbdf0' },
    ],
  },
  {
    name: 'Secondary — Orange',
    colors: [
      { token: '--color-secondary-orange-200', hex: '#ffd6c2' },
      { token: '--color-secondary-orange-300', hex: '#ec6726' },
      { token: '--color-secondary-orange-400', hex: '#ee3d05' },
    ],
  },
  {
    name: 'Tertiary',
    colors: [
      { token: '--color-tertiary-green', hex: '#7ebc26' },
      { token: '--color-tertiary-pink', hex: '#db0a5b' },
      { token: '--color-tertiary-blue', hex: '#0461cf' },
      { token: '--color-tertiary-yellow', hex: '#ffe500' },
    ],
  },
  {
    name: 'Neutral Scale',
    colors: [
      { token: '--color-neutral-100', hex: '#f4f3ee' },
      { token: '--color-neutral-200', hex: '#e8e6dd' },
      { token: '--color-neutral-300', hex: '#dedcd3' },
      { token: '--color-neutral-400', hex: '#c5bfbb' },
      { token: '--color-neutral-500', hex: '#8c8581' },
      { token: '--color-neutral-600', hex: '#463f3a' },
      { token: '--color-neutral-700', hex: '#1a1715' },
    ],
  },
  {
    name: 'Enhancers',
    colors: [
      { token: '--color-enhancer-green', hex: '#89ce00' },
      { token: '--color-enhancer-orange', hex: '#eb3f00' },
    ],
  },
  {
    name: 'Semantic',
    colors: [
      { token: '--color-success', hex: '#109a15' },
      { token: '--color-danger', hex: '#a80c2f' },
      { token: '--color-warning', hex: '#d8b234' },
      { token: '--color-info', hex: '#082538' },
    ],
  },
];

const gradients = [
  { token: '--gradient-beige-white', label: 'Beige → White' },
  { token: '--gradient-beige-black', label: 'Beige → Black' },
  { token: '--gradient-purple', label: 'Purple' },
  { token: '--gradient-blue', label: 'Blue' },
  { token: '--gradient-burgundy', label: 'Burgundy' },
  { token: '--gradient-red', label: 'Red' },
  { token: '--gradient-orange', label: 'Orange' },
];

function isLight(hex: string): boolean {
  const r = parseInt(hex.slice(1, 3), 16);
  const g = parseInt(hex.slice(3, 5), 16);
  const b = parseInt(hex.slice(5, 7), 16);
  return (r * 299 + g * 587 + b * 114) / 1000 > 150;
}
---

<StorybookLayout title="Colors">
  {colorGroups.map((group) => (
    <section class="color-section">
      <h2 class="section-title">{group.name}</h2>
      <div class="swatch-grid">
        {group.colors.map((color) => (
          <div class="swatch">
            <div
              class="swatch-sample"
              style={`background-color: ${color.hex}; color: ${isLight(color.hex) ? '#0b1215' : '#fff'};`}
            >
              {color.hex}
            </div>
            <div class="swatch-info">
              <code>{color.token}</code>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="color-section">
    <h2 class="section-title">Gradients</h2>
    <div class="gradient-grid">
      {gradients.map((grad) => (
        <div class="gradient-card">
          <div class="gradient-sample" style={`background: var(${grad.token});`} />
          <div class="swatch-info">
            <strong>{grad.label}</strong>
            <code>{grad.token}</code>
          </div>
        </div>
      ))}
    </div>
  </section>
</StorybookLayout>

<style>
  .color-section {
    margin-bottom: var(--space-10);
  }

  .section-title {
    font-size: var(--text-h5);
    margin-bottom: var(--space-4);
    color: var(--color-gray-500);
  }

  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--space-4);
  }

  .swatch {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .swatch-sample {
    height: 80px;
    display: flex;
    align-items: flex-end;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-paragraph-xs);
    font-family: monospace;
  }

  .swatch-info {
    padding: var(--space-3);
  }

  .swatch-info code {
    font-size: var(--text-paragraph-xs);
    color: var(--color-gray-400);
    word-break: break-all;
  }

  .gradient-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--space-4);
  }

  .gradient-card {
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-white);
  }

  .gradient-sample {
    height: 100px;
  }

  .gradient-card .swatch-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .gradient-card .swatch-info strong {
    font-size: var(--text-paragraph-small);
  }
</style>
