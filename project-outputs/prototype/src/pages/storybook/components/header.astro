---
import StorybookLayout from '../../../layouts/StorybookLayout.astro';
import Navigation from '../../../components/Navigation.astro';
---

<StorybookLayout title="Header">

  <section class="comp-section">
    <h2 class="section-title">Desktop</h2>
    <p class="section-desc">Full navigation with logo, menu items, search, and tickets CTA. Visible at 768px+.</p>
    <div class="comp-demo comp-demo--wide">
      <Navigation currentPath="/prototype/tickets" />
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">Mobile</h2>
    <p class="section-desc">Compact header with logo, search icon, tickets icon, and hamburger menu. Below 768px.</p>
    <div class="comp-demo comp-demo--mobile">
      <iframe class="comp-demo-frame" src="/storybook/preview/header" title="Header — mobile preview" loading="lazy"></iframe>
    </div>
  </section>



</StorybookLayout>

<style>
  .comp-section {
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-h5);
    margin-bottom: var(--space-2);
    color: var(--color-gray-500);
  }

  .section-desc {
    font-size: var(--text-paragraph-small);
    color: var(--color-gray-300);
    margin-bottom: var(--space-4);
  }

  .comp-demo {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-white);
  }

  .comp-demo--wide {
    min-width: 900px;
  }

  .comp-demo--mobile {
    max-width: 375px;
  }

  .comp-demo-frame {
    display: block;
    width: 375px;
    height: 230px;
    border: none;
  }
</style>
