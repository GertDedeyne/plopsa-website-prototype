---
import StorybookLayout from '../../../layouts/StorybookLayout.astro';
import Button from '../../../components/Button.astro';
import Icon from '../../../components/Icon.astro';

const colors = ['purple', 'red', 'burgundy', 'blue', 'white'] as const;
---

<StorybookLayout title="Button — Primary">

  <section class="comp-section">
    <h2 class="section-title">Color Variants — Large</h2>
    <div class="comp-row">
      <div class="comp-demo">
        {colors.map((c) => (
          <Button color={c} size="lg">{c}</Button>
        ))}
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">Color Variants — Small</h2>
    <div class="comp-row">
      <div class="comp-demo">
        {colors.map((c) => (
          <Button color={c} size="sm">{c}</Button>
        ))}
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">Sizes</h2>
    <div class="comp-row">
      <div class="comp-demo comp-demo--align-end">
        <Button color="purple" size="lg">Large — 56px</Button>
        <Button color="purple" size="sm">Small — 48px</Button>
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">Disabled States</h2>
    <div class="comp-row">
      <div class="comp-demo">
        {colors.map((c) => (
          <Button color={c} size="lg" disabled>{c}</Button>
        ))}
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">With Icons</h2>
    <div class="comp-row">
      <div class="comp-demo">
        <Button color="purple" size="lg">
          <Icon name="medium-ticket" size={20} slot="icon-left" />
          Buy Tickets
        </Button>
        <Button color="red" size="sm">
          Explore
          <Icon name="medium-arrow-right" size={18} slot="icon-right" />
        </Button>
        <Button color="white" size="lg">
          <Icon name="medium-magnifying-glass" size={20} slot="icon-left" />
          Search
        </Button>
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">As Link</h2>
    <div class="comp-row">
      <div class="comp-demo">
        <Button href="/storybook" color="purple" size="lg">Link Button</Button>
        <Button href="/storybook" color="white" size="sm">Link White</Button>
      </div>
    </div>
  </section>


  <section class="comp-section">
    <h2 class="section-title">On Dark Background</h2>
    <div class="comp-row">
      <div class="comp-demo comp-demo--dark">
        <Button color="white" size="lg">White on Dark</Button>
        <Button color="red" size="lg">Red on Dark</Button>
        <Button color="blue" size="sm">Blue on Dark</Button>
      </div>
    </div>
  </section>



</StorybookLayout>

<style>
  .comp-section {
    margin-bottom: var(--space-8);
  }

  .section-title {
    font-size: var(--text-h5);
    margin-bottom: var(--space-4);
    color: var(--color-gray-500);
  }

  .comp-row {
    margin-bottom: var(--space-4);
  }

  .comp-demo {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-white);
  }

  .comp-demo--align-end {
    align-items: flex-end;
  }

  .comp-demo--dark {
    background: var(--color-gray-600);
    border-color: var(--color-gray-500);
  }
</style>
